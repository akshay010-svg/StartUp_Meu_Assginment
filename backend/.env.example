# Server Configuration
PORT=5000

# MongoDB Connection String (MongoDB Compass default local connection)
# You can connect MongoDB Compass to this URI to view databases and collections
MONGODB_URI=mongodb://127.0.0.1:27017/todo_app

# JWT Authentication Secret
JWT_SECRET=dev-todo-app-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# CORS Configuration (allows frontend development server)
CORS_ORIGIN=http://localhost:5173
